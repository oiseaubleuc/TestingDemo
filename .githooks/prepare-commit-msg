#!/bin/bash
# Git hook to automatically generate short commit messages (max 3 words)
# This hook is called after the user writes a commit message

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2
SHA1=$3

# If commit message is already provided via -m or -F, use it
if [ "$COMMIT_SOURCE" = "message" ] || [ "$COMMIT_SOURCE" = "template" ] || [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ]; then
  exit 0
fi

# Get the current commit message
CURRENT_MSG=$(cat "$COMMIT_MSG_FILE")

# If message is empty or just whitespace, generate one
if [ -z "$CURRENT_MSG" ] || [ -z "${CURRENT_MSG// }" ]; then
  # Get changed files
  CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
  
  # Generate short message based on file changes
  if echo "$CHANGED_FILES" | grep -q "frontend"; then
    if echo "$CHANGED_FILES" | grep -q "\.jsx\|\.tsx"; then
      MSG="Update frontend components"
    elif echo "$CHANGED_FILES" | grep -q "\.css"; then
      MSG="Update frontend styles"
    else
      MSG="Update frontend files"
    fi
  elif echo "$CHANGED_FILES" | grep -q "src/"; then
    if echo "$CHANGED_FILES" | grep -q "api/"; then
      MSG="Update API endpoints"
    elif echo "$CHANGED_FILES" | grep -q "services/"; then
      MSG="Update services"
    else
      MSG="Update backend code"
    fi
  elif echo "$CHANGED_FILES" | grep -q "\.yml\|\.yaml"; then
    MSG="Update CI config"
  elif echo "$CHANGED_FILES" | grep -q "package\.json"; then
    MSG="Update dependencies"
  elif echo "$CHANGED_FILES" | grep -q "README"; then
    MSG="Update documentation"
  else
    MSG="Update project files"
  fi
  
  # Ensure max 3 words
  WORD_COUNT=$(echo "$MSG" | wc -w | tr -d ' ')
  if [ "$WORD_COUNT" -gt 3 ]; then
    MSG=$(echo "$MSG" | cut -d' ' -f1-3)
  fi
  
  echo "$MSG" > "$COMMIT_MSG_FILE"
fi

# If message exists but is too long, truncate to 3 words
if [ -n "$CURRENT_MSG" ]; then
  WORD_COUNT=$(echo "$CURRENT_MSG" | wc -w | tr -d ' ')
  if [ "$WORD_COUNT" -gt 3 ]; then
    SHORT_MSG=$(echo "$CURRENT_MSG" | cut -d' ' -f1-3)
    echo "$SHORT_MSG" > "$COMMIT_MSG_FILE"
  fi
fi

exit 0
