# =============================================================================
# RabbitMQ Configuration
# =============================================================================
# RabbitMQ connection URL with authentication
# Format: amqp://username:password@host:port/vhost
# Default credentials: guest/guest (change in production!)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
 
# Main queue name for processing messages
RABBITMQ_QUEUE=orders_queue
 
# Dead Letter Queue - messages that fail after max retries go here
RABBITMQ_DLQ=orders_dlq
 
# =============================================================================
# Security Configuration
# =============================================================================
# API Key for authentication (required for protected endpoints)
# Generate a strong random key - at least 32 characters
# In production: use a strong, random key (e.g., $(openssl rand -hex 32))
API_KEY=your-secure-api-key-here-change-in-production

# Allowed Origins for CORS (comma-separated)
# In production: specify exact domains only
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Enable/Disable Rate Limiting
# Set to 'false' to disable rate limiting (not recommended for production)
ENABLE_RATE_LIMITING=true

# Node Environment
NODE_ENV=development

# =============================================================================
# Salesforce Configuration
# =============================================================================
# Salesforce instance URL (base URL, not Lightning setup page)
SALESFORCE_INSTANCE_URL=https://login.salesforce.com

 
# Connected App Consumer Key (Client ID)
# Create a Connected App in Salesforce with OAuth settings enabled
SALESFORCE_CLIENT_ID=your_client_id_here
 
# Connected App Consumer Secret (Client Secret)
# Found in: Setup → App Manager → Your Connected App → Consumer Secret
# Click "Click to reveal" to see the secret
SALESFORCE_CLIENT_SECRET=your_client_secret_here

# Salesforce Refresh Token (RECOMMENDED - most secure method)
# Get this by using OAuth 2.0 Web Server Flow first time
# Steps:
# 1. Create Connected App in Salesforce with OAuth settings enabled
# 2. Use OAuth 2.0 Web Server Flow to get initial refresh token
# 3. Paste the refresh token here
# This token is used to automatically refresh access tokens
SALESFORCE_REFRESH_TOKEN=your_refresh_token_here

# Salesforce API Version
# Default: v60.0 (latest stable version)
SALESFORCE_API_VERSION=v60.0

# =============================================================================
# Legacy Username/Password Authentication (OPTIONAL - not recommended)
# =============================================================================
# Only use if you cannot use Refresh Token flow
# These are kept for backward compatibility but Refresh Token is preferred
# Security Warning: Username/password authentication is LESS SECURE than OAuth refresh token
# SALESFORCE_USERNAME=your_username@example.com
# SALESFORCE_PASSWORD=your_password+your_security_token
# SALESFORCE_SECURITY_TOKEN=your_security_token

# =============================================================================
# API Configuration
# =============================================================================
API_PORT=3000

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=info
LOG_DIR=./logs
# =============================================================================
# API Configuration
# =============================================================================
# Port for the Producer API server
API_PORT=3000
 
# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: error, warn, info, debug
LOG_LEVEL=info
 
# Directory w