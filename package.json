{
  "name": "rabbitmq-salesforce-integration",
  "version": "1.0.0",
  "description": "RabbitMQ to Salesforce integration with producer and consumer",
  "main": "index.js",
  "scripts": {
    "start:api": "ts-node --files ./src/api/server.ts",
    "start:consumer": "ts-node --files ./src/rabbitmq/start-consumer.ts",
    "start:frontend": "cd frontend && npm run dev",
    "build": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "get-refresh-token": "ts-node --files ./scripts/get-refresh-token.ts",
    "backup:customers": "ts-node ./scripts/backup-customers.ts",
    "setup:hooks": "bash scripts/setup-git-hooks.sh",
    "commit": "bash scripts/auto-commit.sh"
  },
  "keywords": [
    "rabbitmq",
    "salesforce",
    "integration"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "amqplib": "^0.10.9",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^1.7.1",
    "typescript": "^5.3.3"
  }
}
